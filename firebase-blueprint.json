{
  "entities": {
    "contact_messages": {
      "title": "Contact Messages",
      "description": "User contact and feedback submissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID" },
        "name": { "type": "string", "description": "Sender name" },
        "contact": { "type": "string", "description": "Email or phone" },
        "subject": { "type": "string", "description": "Subject category" },
        "message": { "type": "string", "description": "Message body" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission time" },
        "status": { "type": "string", "description": "Status of the message" }
      },
      "required": ["name", "contact", "message", "createdAt"]
    },
    "app_settings": {
      "title": "App Settings",
      "description": "Application settings such as tutorial videos",
      "type": "object",
      "properties": {
        "videos": { "type": "array", "description": "List of tutorial video objects" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update time" }
      }
    },
    "site_analytics": {
      "title": "Site Analytics",
      "description": "Aggregated site usage metrics, visit counters, and activity stats",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number", "description": "Total site visits" },
        "uniqueVisitors": { "type": "number", "description": "Unique device visitors count" },
        "totalRuns": { "type": "number", "description": "Total green flag executions" },
        "totalSaves": { "type": "number", "description": "Total projects saved" },
        "visits": { "type": "number", "description": "Daily visit count" },
        "runs": { "type": "number", "description": "Daily code runs" },
        "saves": { "type": "number", "description": "Daily project saves" },
        "date": { "type": "string", "description": "Date identifier YYYY-MM-DD" },
        "cities": { "type": "object", "description": "Map of city names to visitor counts" },
        "countries": { "type": "object", "description": "Map of country names to visitor counts" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      }
    },
    "user_projects": {
      "title": "User Projects",
      "description": "Projects saved to the cloud by kids",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID" },
        "projectName": { "type": "string", "description": "Project Name" },
        "creatorName": { "type": "string", "description": "Creator Name" },
        "passcode": { "type": "string", "description": "4-digit PIN for access control" },
        "projectCode": { "type": "string", "description": "4-digit auto-generated project code" },
        "scenesData": { "type": "string", "description": "Stringified JSON data of scenes and active state" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["projectName", "creatorName", "projectCode", "scenesData", "createdAt"]
    },
    "creators": {
      "title": "Creators",
      "description": "Registered creator usernames and passcodes",
      "type": "object",
      "properties": {
        "creatorName": { "type": "string", "description": "Display Name of Creator" },
        "passcode": { "type": "string", "description": "Creator Secret Code" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Registration time" }
      },
      "required": ["creatorName", "passcode"]
    }
  },
  "firestore": {
    "/contact_messages/{messageId}": {
      "schema": "contact_messages",
      "description": "User feedback messages"
    },
    "/app_settings/{settingId}": {
      "schema": "app_settings",
      "description": "Tutorial video settings"
    },
    "/site_analytics/{docId}": {
      "schema": "site_analytics",
      "description": "Aggregated stats"
    },
    "/user_projects/{projectId}": {
      "schema": "user_projects",
      "description": "Kid project cloud storage"
    },
    "/creators/{creatorId}": {
      "schema": "creators",
      "description": "Secure creator accounts"
    }
  }
}
